{
  "name": "git-submodule-update",
  "displayName": "Git Submodule Update",
  "description": "Adds Source Control toolbar buttons and a Submodules submenu for git submodule update (--init/--remote), including per-submodule selection.",
  "version": "1.1.0",
  "publisher": "at-besa",
  "icon": "images/icon.png",
  "license": "GPL-3.0-only",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "submodule",
    "submodules",
    "scm",
    "source control",
    "update",
    "init",
    "recursive"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "submoduleUpdate.init",
        "title": "Git: Submodules Init All (update --init --recursive)",
        "icon": "$(repo-clone)"
      },
      {
        "command": "submoduleUpdate.remote",
        "title": "Git: Submodules Remote All (update --remote --recursive)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "submoduleUpdate.initSelected",
        "title": "Git: Submodules Init Selected…",
        "icon": "$(repo-clone)"
      },
      {
        "command": "submoduleUpdate.remoteSelected",
        "title": "Git: Submodules Remote Selected…",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "submoduleUpdate.init",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "command": "submoduleUpdate.remote",
          "when": "scmProvider == git",
          "group": "navigation"
        },
        {
          "submenu": "submoduleUpdate.submenu",
          "when": "scmProvider == git",
          "group": "2_main@9"
        }
      ],
      "submoduleUpdate.submenu": [
        {
          "command": "submoduleUpdate.init",
          "group": "1_update@1"
        },
        {
          "command": "submoduleUpdate.remote",
          "group": "1_update@2"
        },
        {
          "command": "submoduleUpdate.initSelected",
          "group": "2_select@1"
        },
        {
          "command": "submoduleUpdate.remoteSelected",
          "group": "2_select@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "submoduleUpdate.submenu",
        "label": "Submodules"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/at-besa/git-submodule-update.git"
  },
  "bugs": {
    "url": "https://github.com/at-besa/git-submodule-update/issues"
  },
  "homepage": "https://github.com/at-besa/git-submodule-update#readme",
  "scripts": {
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@vscode/vsce": "^4.0.0",
    "semantic-release": "^25.0.9"
  }
}
